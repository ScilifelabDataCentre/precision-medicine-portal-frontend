// Renovate configuration for this repository
// Extends the custom preset defined in the data-centre-template repo
{
  "extends": [
    "github>ScilifelabDataCentre/data-centre-template//.config/renovate/default.jsonc#v1.0.0",
    "config:recommended", 
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "description": "minimumReleaseAge cannot be enforced for lock file maintenance: the package manager resolves the versions itself, so Renovate has no per-release age to check. Left as null rather than an unenforceable 7 days.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    }
  ]
}
