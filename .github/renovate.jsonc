// Renovate configuration for this repository
// Extends the custom preset defined in the data-centre-template repo
{
  "extends": [
    "github>ScilifelabDataCentre/data-centre-template//.config/renovate/default.jsonc#v1.0.0", // Custom preset for the Data Centre
    "helpers:pinGitHubActionDigests", // Pin GitHub Actions to digests to avoid unexpected changes
    "docker:pinDigests" // Pin Docker images to digests to avoid unexpected changes
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Group digest updates for GitHub Actions (minor and patch are grouped in the preset)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pinDigest"], // pinDigest is for the initial pinning of the action to a digest
      "groupName": "GitHub Actions (digest)"
    },
    {
      "description": "Group digest updates for Docker",
      "matchCategories": ["docker"],
      "matchUpdateTypes": ["digest", "pinDigest"], // pinDigest is for the initial pinning of the image to a digest
      "groupName": "Docker (digest)"
    }
  ]
}
